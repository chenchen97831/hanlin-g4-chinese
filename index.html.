      const link = document.createElement("a");\
\
      link.className = "nav-item";\
      link.href = `#$\{item.id\}`;\
      link.dataset.id = item.id;\
\
      const icon = document.createElement("span");\
      icon.className = "nav-icon";\
\
      icon.textContent =\
        item.type === "overview" ? "\uc0\u8962 " : "\u9636 ";\
\
      const title = document.createElement("span");\
      title.textContent = item.title;\
\
      link.appendChild(icon);\
      link.appendChild(title);\
\
      link.addEventListener("click", event => \{\
        event.preventDefault();\
        navigateTo(item.id);\
      \});\
\
      return link;\
    \}\
\
    /* ==========================================\
       5. \uc0\u23563 \u25214 \u25351 \u23450 \u35506 \u31243 \
    ========================================== */\
\
    function findNavigationItem(id) \{\
      return navigationItems.find(item => item.id === id);\
    \}\
\
    /* ==========================================\
       6. \uc0\u26356 \u26032 \u30446 \u21069 \u36984 \u20013 \u30340 \u23566 \u35261 \u38917 \u30446 \
    ========================================== */\
\
    function updateActiveNavigation(id) \{\
      const links = sidebarNav.querySelectorAll(".nav-item");\
\
      links.forEach(link => \{\
        const isActive = link.dataset.id === id;\
\
        link.classList.toggle("active", isActive);\
\
        if (isActive) \{\
          link.setAttribute("aria-current", "page");\
        \} else \{\
          link.removeAttribute("aria-current");\
        \}\
      \});\
    \}\
\
    /* ==========================================\
       7. \uc0\u32178 \u22336  Hash \u23566 \u35261 \
    ========================================== */\
\
    function navigateTo(id) \{\
      const item = findNavigationItem(id);\
\
      if (!item) \{\
        console.warn("\uc0\u25214 \u19981 \u21040 \u35506 \u31243 \u38917 \u30446 \u65306 ", id);\
        return;\
      \}\
\
      // \uc0\u21516 \u27493 \u32178 \u22336  Hash\
      if (window.location.hash !== `#$\{id\}`) \{\
        history.pushState(null, "", `#$\{id\}`);\
      \}\
\
      loadMarkdown(item);\
\
      updateActiveNavigation(id);\
\
      closeMobileMenu();\
\
      window.scrollTo(\{\
        top: 0,\
        behavior: "smooth"\
      \});\
    \}\
\
    /* ==========================================\
       8. \uc0\u36617 \u20837  Markdown \u27284 \u26696 \
    ========================================== */\
\
    async function loadMarkdown(item) \{\
      updateActiveNavigation(item.id);\
\
      breadcrumb.innerHTML = "";\
\
      const breadcrumbText = document.createElement("span");\
      breadcrumbText.textContent = item.title;\
\
      breadcrumb.appendChild(breadcrumbText);\
\
      markdownContent.innerHTML = `\
        <div class="loading-state">\
          <div class="loading-spinner"></div>\
          <p>\uc0\u27491 \u22312 \u36617 \u20837  $\{escapeHTML(item.title)\}...</p>\
        </div>\
      `;\
\
      try \{\
        const response = await fetch(item.path, \{\
          cache: "no-cache"\
        \});\
\
        if (!response.ok) \{\
          throw new Error(\
            `HTTP $\{response.status\}\uc0\u65306 \u28961 \u27861 \u35712 \u21462  $\{item.path\}`\
          );\
        \}\
\
        const markdownText = await response.text();\
\
        // Markdown \uc0\u36681  HTML\
        const rawHTML = marked.parse(markdownText);\
\
        // \uc0\u28165 \u29702  HTML\u65292 \u36991 \u20813 \u19981 \u23433 \u20840 \u30340 \u20839 \u23481 \
        const safeHTML = DOMPurify.sanitize(rawHTML, \{\
          USE_PROFILES: \{\
            html: true\
          \}\
        \});\
\
        markdownContent.innerHTML = safeHTML;\
\
        // \uc0\u34920 \u26684 \u21152 \u20837 \u27243 \u21521 \u25458 \u21205 \u23481 \u22120 \
        enhanceTables();\
\
        // \uc0\u20462 \u27491 \u30456 \u23565 \u36899 \u32080 \
        fixRelativeLinks(item.path);\
\
        // \uc0\u35506 \u31243 \u20999 \u25563 \u24460 \u22238 \u21040 \u38914 \u31471 \
        window.scrollTo(\{\
          top: 0,\
          behavior: "smooth"\
        \});\
\
      \} catch (error) \{\
\
        console.error("Markdown \uc0\u36617 \u20837 \u22833 \u25943 \u65306 ", error);\
\
        markdownContent.innerHTML = `\
          <div class="error-state">\
            <h2>\uc0\u35611 \u32681 \u36617 \u20837 \u22833 \u25943 </h2>\
            <p>\uc0\u30446 \u21069 \u28961 \u27861 \u35712 \u21462 \u36889 \u20221  Markdown \u27284 \u26696 \u12290 </p>\
            <p><strong>\uc0\u27284 \u26696 \u36335 \u24465 \u65306 </strong>$\{escapeHTML(item.path)\}</p>\
            <p><strong>\uc0\u37679 \u35492 \u35338 \u24687 \u65306 </strong>$\{escapeHTML(error.message)\}</p>\
            <p>\
              \uc0\u35531 \u30906 \u35469 \u27284 \u26696 \u26159 \u21542 \u23384 \u22312 \u65292 \u20197 \u21450 \u32178 \u31449 \u26159 \u21542 \u36879 \u36942 \u26412 \u27231 \u20282 \u26381 \u22120 \u25110 \u32178 \u38913 \u20282 \u26381 \u22120 \u38283 \u21855 \u12290 \
            </p>\
            <button\
              class="retry-button"\
              id="retryButton"\
              type="button"\
            >\
              \uc0\u37325 \u26032 \u36617 \u20837 \
            </button>\
          </div>\
        `;\
\
        document\
          .getElementById("retryButton")\
          .addEventListener("click", () => loadMarkdown(item));\
\
      \}\
    \}\
\
    /* ==========================================\
       9. \uc0\u34920 \u26684 \u22686 \u24375 \
    ========================================== */\
\
    function enhanceTables() \{\
      const tables = markdownContent.querySelectorAll("table");\
\
      tables.forEach(table => \{\
        if (table.parentElement.classList.contains("table-scroll")) \{\
          return;\
        \}\
\
        const wrapper = document.createElement("div");\
        wrapper.className = "table-scroll";\
\
        table.parentNode.insertBefore(wrapper, table);\
        wrapper.appendChild(table);\
      \});\
    \}\
\
    /* ==========================================\
       10. \uc0\u30456 \u23565 \u36899 \u32080 \u34389 \u29702 \
    ========================================== */\
\
    function fixRelativeLinks(markdownPath) \{\
      const links = markdownContent.querySelectorAll("a[href]");\
\
      const baseURL = new URL(\
        markdownPath,\
        window.location.href\
      );\
\
      links.forEach(link => \{\
        const href = link.getAttribute("href");\
\
        if (\
          !href ||\
          href.startsWith("#") ||\
          href.startsWith("http://") ||\
          href.startsWith("https://") ||\
          href.startsWith("mailto:")\
        ) \{\
          return;\
        \}\
\
        try \{\
          const resolvedURL = new URL(href, baseURL);\
          link.href = resolvedURL.href;\
        \} catch (error) \{\
          console.warn("\uc0\u28961 \u27861 \u35299 \u26512 \u36899 \u32080 \u65306 ", href);\
        \}\
      \});\
    \}\
\
    /* ==========================================\
       11. HTML \uc0\u25991 \u23383 \u23433 \u20840 \u34389 \u29702 \
    ========================================== */\
\
    function escapeHTML(value) \{\
      return String(value).replace(/[&<>"']/g, char => \{\
        const entities = \{\
          "&": "&amp;",\
          "<": "&lt;",\
          ">": "&gt;",\
          '"': "&quot;",\
          "'": "&#39;"\
        \};\
\
        return entities[char];\
      \});\
    \}\
\
    /* ==========================================\
       12. \uc0\u25163 \u27231 \u29256 \u20596 \u37002 \u27396 \
    ========================================== */\
\
    function openMobileMenu() \{\
      sidebar.classList.add("open");\
      sidebarOverlay.classList.add("show");\
\
      menuButton.setAttribute("aria-expanded", "true");\
      menuButton.setAttribute("aria-label", "\uc0\u38364 \u38281 \u35506 \u31243 \u36984 \u21934 ");\
    \}\
\
    function closeMobileMenu() \{\
      sidebar.classList.remove("open");\
      sidebarOverlay.classList.remove("show");\
\
      menuButton.setAttribute("aria-expanded", "false");\
      menuButton.setAttribute("aria-label", "\uc0\u38283 \u21855 \u35506 \u31243 \u36984 \u21934 ");\
    \}\
\
    menuButton.addEventListener("click", () => \{\
      if (sidebar.classList.contains("open")) \{\
        closeMobileMenu();\
      \} else \{\
        openMobileMenu();\
      \}\
    \});\
\
    sidebarOverlay.addEventListener("click", closeMobileMenu);\
\
    /* ==========================================\
       13. \uc0\u32178 \u22336  Hash \u35722 \u21270 \u30435 \u32893 \
    ========================================== */\
\
    function handleHashChange() \{\
      if (!navigationData) return;\
\
      const id = window.location.hash.replace("#", "");\
\
      const targetId = findNavigationItem(id)\
        ? id\
        : CONFIG.defaultPage;\
\
      const item = findNavigationItem(targetId);\
\
      if (item) \{\
        loadMarkdown(item);\
        updateActiveNavigation(targetId);\
      \}\
    \}\
\
    window.addEventListener("hashchange", handleHashChange);\
\
    window.addEventListener("popstate", handleHashChange);\
\
    /* ==========================================\
       14. \uc0\u21021 \u22987 \u21270 \u32178 \u31449 \
    ========================================== */\
\
    async function initializeWebsite() \{\
      try \{\
        const response = await fetch(CONFIG.navigationFile, \{\
          cache: "no-cache"\
        \});\
\
        if (!response.ok) \{\
          throw new Error(\
            `HTTP $\{response.status\}\uc0\u65306 \u28961 \u27861 \u35712 \u21462  lessons.json`\
          );\
        \}\
\
        const data = await response.json();\
\
        if (!data.site || !Array.isArray(data.navigation)) \{\
          throw new Error("lessons.json \uc0\u26684 \u24335 \u19981 \u27491 \u30906 \u12290 ");\
        \}\
\
        renderNavigation(data);\
\
        // \uc0\u20381 \u29031 \u32178 \u22336  Hash \u27770 \u23450 \u21021 \u22987 \u39023 \u31034 \u38913 \u38754 \
        const hashId = window.location.hash.replace("#", "");\
\
        const initialId = findNavigationItem(hashId)\
          ? hashId\
          : CONFIG.defaultPage;\
\
        const initialItem = findNavigationItem(initialId);\
\
        if (initialItem) \{\
          if (!window.location.hash ||\
              window.location.hash !== `#$\{initialId\}`) \{\
            history.replaceState(null, "", `#$\{initialId\}`);\
          \}\
\
          loadMarkdown(initialItem);\
          updateActiveNavigation(initialId);\
        \}\
\
      \} catch (error) \{\
\
        console.error("\uc0\u32178 \u31449 \u21021 \u22987 \u21270 \u22833 \u25943 \u65306 ", error);\
\
        sidebarNav.innerHTML = `\
          <div class="error-state">\
            <strong>\uc0\u35506 \u31243 \u30446 \u37636 \u36617 \u20837 \u22833 \u25943 </strong>\
            <p>$\{escapeHTML(error.message)\}</p>\
          </div>\
        `;\
\
        markdownContent.innerHTML = `\
          <div class="error-state">\
            <h2>\uc0\u32178 \u31449 \u21021 \u22987 \u21270 \u22833 \u25943 </h2>\
            <p>\uc0\u35531 \u30906 \u35469  lessons.json \u26159 \u21542 \u23384 \u22312 \u65292 \u20197 \u21450  JSON \u26684 \u24335 \u26159 \u21542 \u27491 \u30906 \u12290 </p>\
            <p>$\{escapeHTML(error.message)\}</p>\
          </div>\
        `;\
\
      \}\
    \}\
\
    // \uc0\u21855 \u21205 \u32178 \u31449 \
    initializeWebsite();\
\
  </script>\
\
</body>\
</html>}
